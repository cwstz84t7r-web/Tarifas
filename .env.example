# Cadena de conexión de Supabase (Project Settings -> Database -> Connection string -> URI,
# usa la versión "Transaction pooler", puerto 6543)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# La contraseña que usarás tú para entrar en la app desde el móvil
APP_PASSWORD=elige-una-contraseña-larga

# Cadena aleatoria usada para firmar la sesión de forma segura (no la compartas)
# Puedes generarla en https://1password.com/password-generator/ o con cualquier
# generador de contraseñas: cuanto más larga y aleatoria, mejor.
SESSION_SECRET=otra-cadena-aleatoria-larga-y-distinta
